APP_NAME=BioHelix
# Pass this file at build/run time with `--dart-define-from-file=.env`.
# Never add provider API keys here; mobile build values are public.
# API_BASE_URL=http://127.0.0.1:8787/api
# API_BASE_URL=http://192.168.20.8:8787/api
# API_BASE_URL=http://10.237.69.159:8787/api
# API_BASE_URL=http://192.168.0.157:8787/api
API_BASE_URL=https://www.bhrchospital.com/api/v1
HEALTH_ENDPOINT=/health
REFERRAL_LINK_HOST=www.bhrchospital.com
# Optional: set to true only for local/dev builds when the backend returns a dev OTP.
# SHOW_DEV_OTP=false

SARVAM_API_KEY=
